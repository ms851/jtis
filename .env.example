# =============================================================================
# JTIS Environment Configuration
# =============================================================================

# --- General ---
ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production

# --- Backend ---
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Database ---
DATABASE_URL=postgresql+asyncpg://jtis:jtis_secret@postgres:5432/jtis
DATABASE_URL_SYNC=postgresql://jtis:jtis_secret@postgres:5432/jtis
POSTGRES_USER=jtis
POSTGRES_PASSWORD=jtis_secret
POSTGRES_DB=jtis

# --- Keycloak ---
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=jtis
KEYCLOAK_CLIENT_ID=jtis-backend
KEYCLOAK_CLIENT_SECRET=change-me
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- Frontend Keycloak ---
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=jtis
VITE_KEYCLOAK_CLIENT_ID=jtis-frontend
VITE_API_BASE_URL=http://localhost:8000

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Container Registry ---
GHCR_REGISTRY=ghcr.io/ms851
